# Address the Vite dev server proxies /graphql, /graphql/ws and /api to.
# Never used by the browser; the browser always talks to the same origin.
BACKEND_PROXY_TARGET=http://127.0.0.1:3001

# Public origin when the dev server is exposed through a reverse proxy (HMR websocket).
# DEV_SERVER_PUBLIC_URL=https://librarian.example.com

# Schema source for codegen. Defaults to the live backend introspection endpoint.
# SCHEMA_URL=http://127.0.0.1:3001/graphql
