{
  "name": "librarian-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run generate && pnpm run icons && tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "generate": "pnpm run codegen && node scripts/generate-route-tree.mjs",
    "codegen": "node scripts/generate-entity-documents.mjs && graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lint": "pnpm run generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run generate && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "schema:pull": "node scripts/pull-schema.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "film-graph": "node scripts/generate-film-graph.mjs",
    "audit:ci": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-router": "^1.170.32",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.1",
    "hls.js": "^1.7.2",
    "motion": "^13.2.0",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "rxjs": "^7.8.2",
    "three": "^0.185.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
