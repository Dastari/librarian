{
  "name": "librarian-web",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run generate && pnpm run icons && tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "generate": "pnpm run codegen && node scripts/generate-route-tree.mjs",
    "codegen": "node scripts/generate-entity-documents.mjs && graphql-codegen --config codegen.ts",
    "codegen:watch": "node scripts/watch-codegen.mjs",
    "codegen:check": "node scripts/generate-entity-documents.mjs --check",
    "lint": "pnpm run generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run generate && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "schema:pull": "node scripts/pull-schema.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "film-graph": "node scripts/generate-film-graph.mjs",
    "audit:ci": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^6.0.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "glass-ux": "https://github.com/Dastari/glass-ux/releases/download/v0.12.1/glass-ux-0.12.1.tgz",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.4.1",
    "hls.js": "^1.7.3",
    "motion": "^14.7.1",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
