# Required authentication signing secret (at least 32 bytes).
LIBRARIAN_JWT_SECRET=

# Required to create or use acquisition sources with credentials. Generate an
# exact 32-byte key as base64: `openssl rand -base64 32`.
LIBRARIAN_SOURCE_CREDENTIAL_KEY=
# Prefer a root/service-readable 0600 file over an environment variable:
# LIBRARIAN_SOURCE_CREDENTIAL_KEY_FILE=/run/secrets/librarian-source-key

# Browser/deployment security.
LIBRARIAN_SECURE_COOKIES=false
LIBRARIAN_TRUSTED_PROXIES=
LIBRARIAN_ADVERTISED_MEDIA_URL=
LIBRARIAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
# For the live HTTPS domain, set these in the backend process environment/backend/.env:
# LIBRARIAN_SECURE_COOKIES=true
# LIBRARIAN_CORS_ORIGINS=https://librarian.dastari.net,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
CAST_DISCOVERY_RETENTION_DAYS=30

# Core paths.
DATABASE_PATH=./backend/data/librarian.db
MEDIA_PATH=./backend/data/media
DOWNLOADS_PATH=./backend/data/downloads
CACHE_PATH=./backend/data/cache
SESSION_PATH=./backend/data/session
STORAGE_PATH=./backend/data/storage
BACKUP_PATH=./backend/data/backups

# Optional metadata providers.
TMDB_API_KEY=
TVDB_API_KEY=

# TV guide: daily seven-day TVmaze broadcast schedule plus global streaming.
# Comma-separated ISO country codes (GB, not UK), maximum 8.
LIBRARIAN_SCHEDULE_COUNTRIES=US
