node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
web/dist/
web/dev-dist/
web/screenshots/
web/playwright-report/
web/test-results/


# Data directories (for local dev)
/data/

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
