<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LibrarianTv" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/canvas</item>
        <item name="android:colorPrimaryDark">@color/canvas</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="TvButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center_vertical|start</item>
    </style>
</resources>
