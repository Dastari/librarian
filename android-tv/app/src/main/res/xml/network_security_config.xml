<?xml version="1.0" encoding="utf-8"?>
<!-- Librarian servers on a home network are usually plain http on a LAN address, so cleartext is
     allowed. HTTPS still uses the system's trusted certificates only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
