<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/server_title"
            android:textColor="@color/foreground"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/discovery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/server_searching"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/discovered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@+id/address"
            android:text="@string/server_address_label"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="url"
            android:background="@drawable/field_background"
            android:hint="@string/server_address_hint"
            android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/foreground"
            android:textColorHint="#80B4B4C2"
            android:textSize="18sp" />

        <Button
            android:id="@+id/connect"
            style="@style/TvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/server_connect" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/danger"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/use_anyway"
            style="@style/TvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/server_use_anyway"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/server_help"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
